# CadetConnect Backend Environment Template

PORT=5000
NODE_ENV=production

# JWT Authentication Secret Key
JWT_SECRET=your_super_secret_jwt_key_here

# PostgreSQL Connection String (Neon.tech / Supabase / AWS RDS)
DATABASE_URL="postgresql://user:password@hostname:5432/cadetconnect?sslmode=require"

# CORS Origins
CORS_ORIGINS="http://localhost:5173,https://yourdomain.com"

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
